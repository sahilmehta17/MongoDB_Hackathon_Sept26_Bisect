{
  "name": "bisect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check-data": "tsx scripts/check-data.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "run-task": "tsx --env-file=.env.local scripts/run-task.ts",
    "eval": "tsx --env-file=.env.local scripts/eval.ts",
    "build-history": "tsx --env-file=.env.local scripts/build-history.ts",
    "test:db": "node --env-file=.env.local --import tsx --test tests/db/*.test.ts",
    "calibrate-immune": "tsx --env-file=.env.local scripts/calibrate-immune.ts"
  },
  "dependencies": {
    "mongodb": "^7.6.0",
    "next": "16.3.6",
    "openai": "^7.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "workflow": "^4.8.9",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
